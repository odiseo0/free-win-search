# PostgreSQL
DB_HOST=
DB_NAME=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
SQLALCHEMY_DATABASE_URI=

# Digital Ocean Spaces Variables
STORAGE_DRIVER=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Other variables
TOKEN_SECRET=
DEV_MODE=

# Cache: use "memory" locally or "valkey" when a server is available.
API_ENVIRONMENT=development
CACHE_BACKEND=memory
CACHE_URL=valkey://localhost:6379/0
CACHE_KEY_PREFIX=free-win:
CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=2

# Card discovery. MeiliSearch is an independently managed external service.
SEARCH_BACKEND=postgresql
SEARCH_MEILISEARCH_URL=
SEARCH_MEILISEARCH_API_KEY=
SEARCH_INDEX_UID=cards
SEARCH_TIMEOUT_SECONDS=5
SEARCH_MAX_CONNECTIONS=20
SEARCH_MAX_CONCURRENCY=10
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BACKOFF_SECONDS=0.1
SEARCH_MAX_RETRY_DELAY_SECONDS=5
SEARCH_TASK_TIMEOUT_SECONDS=30
SEARCH_TASK_POLL_INTERVAL_SECONDS=0.1
SEARCH_OUTBOX_BATCH_SIZE=100
SEARCH_OUTBOX_LEASE_SECONDS=60
SEARCH_OUTBOX_POLL_SECONDS=2
SEARCH_OUTBOX_BACKOFF_SECONDS=5

# Durable scraper worker
SCRAPER_POLL_SECONDS=2
SCRAPER_LEASE_SECONDS=180
SCRAPER_MAX_ATTEMPTS=4
SCRAPER_RETRY_DELAYS_SECONDS=[60,300,900,3600]
SCRAPER_CONCURRENCY=5
SCRAPER_HTTP_TIMEOUT_SECONDS=15
SCRAPER_MIN_HOST_INTERVAL_SECONDS=0.25

# Temporary local identity. Keep disabled unless developing locally.
AUTH_MODE=disabled
AUTH_LOCAL_USER_ID=
